snowflake_dbt_mini_project:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: DBT_ROLE
      database: DBT_MINI_PROJECT
      warehouse: DBT_WH
      schema: DBT_MINI_DEV
      threads: 4
      client_session_keep_alive: false
      query_tag: dbt_mini_project

